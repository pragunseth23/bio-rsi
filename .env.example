BACKEND_URL=http://127.0.0.1:8000
DATABASE_PATH=backend/data/discovery.sqlite
ITERATION_DELAY=0.18
# YZi Labs: BSC Testnet by default; also supports opbnb-testnet or base-sepolia.
CHAIN_NETWORK=bsc-testnet
CHAIN_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
CHAIN_CONFIRMATIONS=3
# Only use a testnet wallet. Its address must own the deployed contract.
WALLET_PRIVATE_KEY=
CONTRACT_ADDRESS=
# Returned by contract:deploy; speeds event recovery for legacy records.
CONTRACT_DEPLOYMENT_BLOCK=0
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
