# All secrets remain on the backend. Never use NEXT_PUBLIC_ for credentials.
BACKEND_URL=http://127.0.0.1:8000
DATABASE_PATH=backend/data/discovery.sqlite
ITERATION_DELAY=0.18
# Onchain commitments (YZi Labs track: BNB Chain). Leave WALLET_PRIVATE_KEY and
# CONTRACT_ADDRESS empty for clearly labeled local-only SHA-256 mode.
# CHAIN: bsc-testnet (default, chain 97) | opbnb-testnet (5611) | base-sepolia (84532)
CHAIN=bsc-testnet
# Optional; defaults to the network's public RPC.
RPC_URL=
WALLET_PRIVATE_KEY=
CONTRACT_ADDRESS=
# Optional OpenAI-compatible Chat Completions service.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
